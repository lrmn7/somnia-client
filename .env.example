# Somnia Network Selection ('mainnet' | 'testnet')
SOMNIA_NETWORK=testnet

# Optional custom RPC URL overrides (defaults to official Somnia endpoints)
SOMNIA_RPC_URL=
SOMNIA_WS_URL=

# Optional signing wallet private key (0x... - NEVER commit real keys)
SOMNIA_PRIVATE_KEY=

# Optional Discord Bot Integration
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
